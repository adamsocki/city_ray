{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build raylib",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build raylib application using Makefile"
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": [],
            "detail": "Clean build artifacts"
        },
        {
            "label": "make: debug",
            "type": "shell",
            "command": "make",
            "args": ["CFLAGS+= -g -O0"],
            "options": {
              "cwd": "${workspaceFolder}"
            },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
          }
    ]
}
